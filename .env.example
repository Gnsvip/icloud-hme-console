# Example for a process manager EnvironmentFile; Python does not load this file automatically.
ADMIN_USER=admin
# Set a unique password before starting. An empty value causes startup to fail.
ADMIN_PASSWORD=
# Optional. If omitted, a random signing secret is stored in results/.
# ADMIN_SECRET_KEY=
HOST=127.0.0.1
PORT=5050
# Optional dedicated HTTP CONNECT proxy for Apple login and iCloud HTTP APIs.
# Applies to these clients only; does not change the selected iCloud region.
# ICLOUD_PROXY_URL=http://127.0.0.1:7892
